---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, getAlternateLocales } from '../i18n/utils';

// Self-host Inter font for 100/100 PageSpeed Insights score
import '@fontsource-variable/inter';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  lang?: string;
  appendSiteName?: boolean;
}

const detectedLang = getLangFromUrl(Astro.url);

const {
  title,
  description,
  image = '/og-default.png',
  canonicalUrl,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  lang = detectedLang,
  appendSiteName = true,
} = Astro.props;

const t = useTranslations(detectedLang);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://astro-seo-theme.vercel.app';
const currentUrl = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();
const siteName = 'CALCIO';
const fullTitle = appendSiteName ? `${title} | ${siteName}` : title;
const alternateLocales = getAlternateLocales(Astro.url.pathname);
---

<!doctype html>
<html lang={lang} class="scroll-smooth overflow-x-hidden">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8XC7N57SWW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8XC7N57SWW');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={currentUrl} />

    <!-- Hreflang tags for i18n -->
    {alternateLocales.map(({ lang: altLang, href }) => (
      <link
        rel="alternate"
        hreflang={altLang === 'en' ? 'en-US' : 'es'}
        href={new URL(href, siteUrl).toString()}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternateLocales[0].href, siteUrl).toString()}
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'es' ? 'es_419' : 'en_US'} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={currentUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Dark Mode: Inline script to prevent FOUC -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme');
        if (
          theme === 'dark' ||
          (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- Slot for page-specific head content (JSON-LD, hreflang, etc.) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-[var(--bg)] text-[var(--text-primary)] antialiased transition-colors duration-200">
    <!-- Skip to main content (a11y) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-white"
    >
      {t('skipToContent')}
    </a>

    <slot name="header" />

    <main id="main-content">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
