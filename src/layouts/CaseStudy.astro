---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { Image } from 'astro:assets';

interface Props {
  caseStudy: CollectionEntry<'case-studies'>;
}

const { caseStudy } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  client,
  industry,
  results,
  testimonial,
  tags,
} = caseStudy.data;

const siteUrl = Astro.site?.toString() ?? 'https://astro-seo-theme.vercel.app';
const articleUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<BaseLayout
  title={`${client} Case Study: ${title}`}
  description={description}
  image={heroImage?.src}
  ogType="article"
>
  <Fragment slot="head">
    <JsonLd
      type="BlogPosting"
      data={{
        headline: `${client} Case Study: ${title}`,
        description: description,
        url: articleUrl,
        datePublished: pubDate.toISOString(),
        dateModified: updatedDate?.toISOString(),
        image: heroImage ? new URL(heroImage.src, siteUrl).toString() : undefined,
        author: { name: 'Astro SEO Theme' },
        publisher: { name: 'Astro SEO Theme' },
      }}
    />
  </Fragment>

  <Header slot="header" />

  <article class="mx-auto max-w-5xl px-6 py-12 md:py-20">
    <!-- Breadcrumbs -->
    <div class="mb-10 flex justify-center md:mb-16">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Case Studies', href: '/case-studies' },
          { label: client },
        ]}
      />
    </div>

    <!-- Header Section -->
    <header class="mb-16 text-center">
      <div class="mb-6 flex justify-center gap-3">
        <span class="rounded-full bg-[var(--bg-secondary)] border border-[var(--border)] px-4 py-1.5 text-sm font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
          Client: {client}
        </span>
        <span class="rounded-full bg-[var(--bg-secondary)] border border-[var(--border)] px-4 py-1.5 text-sm font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
          Industry: {industry}
        </span>
      </div>

      <h1 class="mx-auto max-w-4xl font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)] md:text-5xl lg:text-6xl">
        {title}
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg text-[var(--text-secondary)] md:text-xl">
        {description}
      </p>
    </header>

    <!-- Key Results Highlight -->
    {results && results.length > 0 && (
      <section class="mb-16 rounded-3xl border border-[var(--border)] bg-[var(--bg-secondary)]/50 p-8 md:p-12">
        <h2 class="sr-only">Key Results</h2>
        <div class="grid gap-8 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-[var(--border)]">
          {results.slice(0, 3).map((result) => (
            <div class="flex flex-col items-center text-center pt-8 first:pt-0 sm:pt-0 sm:px-8 first:sm:pl-0 last:sm:pr-0">
              <p class="font-display text-4xl font-extrabold text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)] md:text-5xl">
                {result.value}
              </p>
              <p class="mt-2 text-sm font-bold uppercase tracking-widest text-[var(--text-primary)]">
                {result.metric}
              </p>
              {result.description && (
                <p class="mt-3 text-sm text-[var(--text-secondary)]">{result.description}</p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Testimonial Section -->
    {testimonial && (
      <blockquote class="my-16 rounded-3xl bg-[var(--color-primary-900)] p-8 text-center sm:p-12">
        <svg
          class="mx-auto mb-6 h-10 w-10 text-[var(--color-primary-400)] opacity-50"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
        </svg>
        <p class="font-display text-xl font-medium leading-relaxed text-white md:text-3xl">
          "{testimonial.quote}"
        </p>
        <footer class="mt-8">
          <div class="flex items-center justify-center gap-4">
            {testimonial.avatar && (
              <Image
                src={testimonial.avatar}
                alt={testimonial.author}
                width={48}
                height={48}
                class="h-12 w-12 rounded-full border-2 border-[var(--color-primary-500)] object-cover"
              />
            )}
            <div class="text-left">
              <p class="font-bold text-white">{testimonial.author}</p>
              <p class="text-sm text-[var(--color-primary-300)]">{testimonial.role}</p>
            </div>
          </div>
        </footer>
      </blockquote>
    )}

    <!-- Main Content -->
    <div class="prose prose-lg mx-auto prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-[var(--text-primary)] prose-a:text-[var(--color-primary-600)] dark:prose-a:text-[var(--color-primary-400)] hover:prose-a:text-[var(--color-primary-700)] dark:hover:prose-a:text-[var(--color-primary-300)] prose-img:rounded-xl prose-img:border prose-img:border-[var(--border)]">
      <slot />
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>
