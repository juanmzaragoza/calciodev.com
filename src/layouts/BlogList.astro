---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  posts: CollectionEntry<'blog'>[];
  basePath?: string;
}

const { title, description, posts, basePath = '/blog/' } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <main class="mx-auto max-w-7xl px-6 py-20 md:py-32">
    <header class="mx-auto max-w-2xl text-center md:mb-20">
      <h1 class="font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)] md:text-5xl lg:text-6xl">
        {title}
      </h1>
      <p class="mt-6 text-lg text-[var(--text-secondary)] md:text-xl">{description}</p>
    </header>

    <div class="mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <article class="group relative flex flex-col items-start justify-between rounded-3xl border border-[var(--border)] bg-[var(--bg)] p-6 shadow-sm transition-all hover:shadow-md hover:border-[var(--border-hover)]">
          <div class="mb-4 flex flex-wrap items-center gap-2 text-xs">
            <time datetime={post.data.pubDate.toISOString()} class="text-[var(--text-tertiary)] whitespace-nowrap">
              {dateFormatter.format(post.data.pubDate)}
            </time>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="relative z-10 rounded-full bg-[var(--color-primary-50)] px-3 py-1.5 font-medium text-[var(--color-primary-700)] dark:bg-[var(--color-primary-500)]/10 dark:text-[var(--color-primary-300)]">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <div class="group relative">
            <h2 class="mt-3 text-xl font-semibold leading-6 text-[var(--text-primary)] group-hover:text-[var(--text-secondary)]">
              <a href={`${basePath}${post.id.replace(/^(en|es)\//, '')}`}>
                <span class="absolute inset-0"></span>
                {post.data.title}
              </a>
            </h2>
            <p class="mt-4 line-clamp-3 text-sm leading-6 text-[var(--text-secondary)]">
              {post.data.description}
            </p>
          </div>

          <div class="relative mt-8 flex items-center gap-x-4">
            <div class="text-sm leading-6">
              <p class="font-semibold text-[var(--text-primary)]">
                <span class="absolute inset-0"></span>
                {post.data.author}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
