---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  caseStudies: CollectionEntry<'case-studies'>[];
  basePath?: string;
}

const { title, description, caseStudies, basePath = '/case-studies/' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <main class="mx-auto max-w-7xl px-6 py-20 md:py-32">
    <header class="mx-auto max-w-3xl text-center md:mb-24">
      <h1 class="font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl lg:text-6xl">
        {title}
      </h1>
      <p class="mt-6 text-lg text-[var(--text-secondary)] md:text-xl">{description}</p>
    </header>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {caseStudies.map((study) => (
        <a
          href={`${basePath}${study.id.replace(/^(en|es)\//, '')}`}
          class="group flex flex-col justify-between overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--bg)] transition-all hover:shadow-lg hover:border-[var(--color-primary-500)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary-500)]"
        >
          {study.data.heroImage ? (
            <div class="aspect-[16/9] w-full overflow-hidden border-b border-[var(--border)] bg-[var(--bg-secondary)]">
              <img
                src={study.data.heroImage.src}
                alt={study.data.client}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                width="600"
                height="338"
              />
            </div>
          ) : (
            <div class="flex aspect-[16/9] w-full items-center justify-center border-b border-[var(--border)] bg-gradient-to-br from-[var(--color-primary-100)] to-[var(--color-primary-50)] dark:from-[var(--color-primary-900)] dark:to-[var(--color-primary-950)]">
              <span class="font-display text-2xl font-bold text-[var(--color-primary-500)] dark:text-[var(--color-primary-300)]">
                {study.data.client}
              </span>
            </div>
          )}

          <div class="flex flex-1 flex-col p-8">
            <div class="mb-4 flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-[var(--bg-secondary)] px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                {study.data.industry}
              </span>
            </div>

            <h2 class="mb-3 text-xl font-bold text-[var(--text-primary)] group-hover:text-[var(--color-primary-500)] transition-colors">
              {study.data.title}
            </h2>

            <p class="line-clamp-3 text-sm text-[var(--text-secondary)] leading-relaxed">
              {study.data.description}
            </p>

            {study.data.results && study.data.results.length > 0 && (
              <div class="mt-8 border-t border-[var(--border)] pt-6">
                <div class="grid grid-cols-2 gap-4">
                  {study.data.results.slice(0, 2).map((result) => (
                    <div>
                      <p class="font-display text-2xl font-bold text-[var(--color-primary-500)]">
                        {result.value}
                      </p>
                      <p class="text-xs font-medium uppercase tracking-wide text-[var(--text-tertiary)]">
                        {result.metric}
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
