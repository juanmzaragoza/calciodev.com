---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, noindex, canonicalUrl } =
  post.data;

// Fetch author data for E-E-A-T and Schema
const author = await getEntry('authors', post.data.author);
const authorName = author ? author.data.name : 'Astro SEO Theme';
const authorRole = author ? author.data.role : 'Editorial Team';

const siteUrl = Astro.site?.toString() ?? 'https://astro-seo-theme.vercel.app';
const articleUrl = new URL(Astro.url.pathname, siteUrl).toString();

// Formatter for dates
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage?.src}
  ogType="article"
  noindex={noindex}
  canonicalUrl={canonicalUrl}
>
  <Fragment slot="head">
    <JsonLd
      type="BlogPosting"
      data={{
        headline: title,
        description: description,
        url: articleUrl,
        datePublished: pubDate.toISOString(),
        dateModified: updatedDate?.toISOString(),
        image: heroImage ? new URL(heroImage.src, siteUrl).toString() : undefined,
        author: {
          name: authorName,
          // url: author ? new URL(`/authors/${author.id}`, siteUrl).toString() : undefined
        },
        publisher: {
          name: 'Astro SEO Theme',
          // logo: new URL('/logo.png', siteUrl).toString()
        },
      }}
    />
    {author && (
      <JsonLd
        type="Person"
        data={{
          name: authorName,
          jobTitle: authorRole,
          description: author.data.bio,
          image: author.data.avatar
            ? new URL(author.data.avatar.src, siteUrl).toString()
            : undefined,
          sameAs: author.data.social
            ? (Object.values(author.data.social).filter(Boolean) as string[])
            : undefined,
        }}
      />
    )}
  </Fragment>

  <Header slot="header" />

  <article class="mx-auto max-w-4xl px-6 py-12 md:py-20">
    <!-- Breadcrumbs & Meta -->
    <header class="mb-10 text-center md:mb-16">
      <div class="mb-6 flex justify-center">
        <Breadcrumbs
          items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }, { label: title }]}
        />
      </div>

      <div class="mb-4 flex flex-wrap justify-center gap-2">
        {tags.map((tag) => (
          <span class="rounded-full bg-[var(--color-primary-50)] px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[var(--color-primary-500)] dark:bg-[var(--color-primary-500)]/10 dark:text-[var(--color-primary-400)]">
            {tag}
          </span>
        ))}
      </div>

      <h1 class="font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)] md:text-5xl lg:text-6xl">
        {title}
      </h1>

      <p class="mt-6 text-lg text-[var(--text-secondary)] md:text-xl">{description}</p>

      <div class="mt-8 flex items-center justify-center gap-4 text-sm text-[var(--text-tertiary)]">
        {author && author.data.avatar && (
          <img
            src={author.data.avatar.src}
            alt={authorName}
            class="h-10 w-10 rounded-full object-cover shadow-sm"
          />
        )}
        <div class="text-left">
          <p class="font-semibold text-[var(--text-primary)]">{authorName}</p>
          <p>
            <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
            {updatedDate && (
              <span class="italic"> (Updated: {dateFormatter.format(updatedDate)})</span>
            )}
          </p>
        </div>
      </div>
    </header>

    {heroImage && (
      <figure class="mb-12 overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--bg-secondary)] shadow-sm">
        <img
          src={heroImage.src}
          alt={title}
          width={heroImage.width}
          height={heroImage.height}
          class="w-full object-cover"
        />
      </figure>
    )}

    <!-- MDX Content via tailwindcss/typography -->
    <div class="prose prose-lg mx-auto prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-[var(--text-primary)] prose-a:text-[var(--color-primary-500)] hover:prose-a:text-[var(--color-primary-600)] prose-img:rounded-xl prose-img:border prose-img:border-[var(--border)]">
      <slot />
    </div>

    <!-- E-E-A-T Author Box (Bottom) -->
    {author && (
      <aside class="mx-auto mt-16 max-w-2xl rounded-2xl border border-[var(--border)] bg-[var(--bg-secondary)] p-8 shadow-sm">
        <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:text-left">
          {author.data.avatar && (
            <img
              src={author.data.avatar.src}
              alt={authorName}
              class="h-20 w-20 shrink-0 rounded-full object-cover ring-2 ring-[var(--border)]"
            />
          )}
          <div>
            <h3 class="text-lg font-bold text-[var(--text-primary)]">{authorName}</h3>
            <p class="font-medium text-[var(--color-primary-500)]">{authorRole}</p>
            <p class="mt-2 text-sm text-[var(--text-secondary)] leading-relaxed">
              {author.data.bio}
            </p>
            {author.data.social && (
              <div class="mt-4 flex items-center justify-center gap-4 sm:justify-start">
                {author.data.social.twitter && (
                  <a
                    href={author.data.social.twitter}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text-tertiary)] hover:text-[var(--color-primary-500)] transition-colors"
                  >
                    <span class="sr-only">Twitter</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                    </svg>
                  </a>
                )}
                {author.data.social.linkedin && (
                  <a
                    href={author.data.social.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text-tertiary)] hover:text-[var(--color-primary-500)] transition-colors"
                  >
                    <span class="sr-only">LinkedIn</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path
                        fill-rule="evenodd"
                        d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </a>
                )}
                {author.data.social.github && (
                  <a
                    href={author.data.social.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text-tertiary)] hover:text-[var(--color-primary-500)] transition-colors"
                  >
                    <span class="sr-only">GitHub</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path
                        fill-rule="evenodd"
                        d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </a>
                )}
                {author.data.social.website && (
                  <a
                    href={author.data.social.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text-tertiary)] hover:text-[var(--color-primary-500)] transition-colors"
                  >
                    <span class="sr-only">Website</span>
                    <svg
                      class="h-5 w-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                      />
                    </svg>
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </aside>
    )}
  </article>

  <Footer slot="footer" />
</BaseLayout>
