---
/**
 * FaqSchema.astro — FAQ Section with automatic FAQPage Schema
 *
 * Renders an accessible FAQ accordion and injects FAQPage JSON-LD
 * schema automatically. Designed for use inside MDX blog posts.
 *
 * Usage in MDX:
 *   import FaqSchema from '../../components/seo/FaqSchema.astro';
 *
 *   <FaqSchema items={[
 *     { question: "What is Astro?", answer: "Astro is a modern..." },
 *     { question: "Is it free?", answer: "Yes, 100% open-source." }
 *   ]} />
 */

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="my-8" aria-label="Frequently Asked Questions">
  <dl class="divide-y divide-[var(--border)]">
    {items.map((item) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer items-center justify-between gap-4 text-lg font-semibold text-[var(--text-primary)] transition-colors hover:text-[var(--color-primary-500)]">
          <dt>{item.question}</dt>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <dd class="mt-3 text-[var(--text-secondary)] leading-relaxed">{item.answer}</dd>
      </details>
    ))}
  </dl>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema, null, 2)}></script>
