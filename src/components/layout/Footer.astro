---
/**
 * Footer.astro — Site footer with navigation columns and social links
 */
import Logo from '../Logo.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const footerColumns = [
  {
    title: lang === 'en' ? 'Services' : 'Servicios',
    links: [
      { label: lang === 'en' ? 'Audit' : 'Auditoría', href: getLocalizedPath(lang, '/services/audit') },
      { label: t('nav.caseStudies'), href: getLocalizedPath(lang, '/case-studies') },
    ],
  },
  {
    title: lang === 'en' ? 'Company' : 'Empresa',
    links: [
      { label: t('nav.about'), href: getLocalizedPath(lang, '/about') },
      { label: t('nav.blog'), href: getLocalizedPath(lang, '/blog') },
      { label: lang === 'en' ? 'LinkedIn' : 'LinkedIn', href: 'https://www.linkedin.com/company/calcio-dev-llc' },
    ],
  },
];
---

<footer class="border-t border-[var(--border)] bg-[var(--bg)]">
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1">
        <a
          href={getLocalizedPath(lang, '/')}
          class="flex items-center gap-2"
          aria-label="CALCIO — Home"
        >
          <Logo variant="full" />
        </a>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
          Your company grew. Your systems didn't. We fix that.
        </p>

        <!-- Email -->
        <a
          href="mailto:hello@calciodev.com"
          class="mt-4 inline-flex items-center gap-2 text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25H4.5a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5H4.5A2.25 2.25 0 0 0 2.25 6.75m19.5 0v-1.5a2.25 2.25 0 0 0-2.25-2.25H4.5A2.25 2.25 0 0 0 2.25 4.5v1.5m0 0h19.5m-2.25-4.5v6m-10.875 0H12m-1.5 0H9.75"
            />
          </svg>
          hello@calciodev.com
        </a>

        <!-- Social icons -->
        <div class="mt-4 flex items-center gap-3">
          <!-- LinkedIn Company -->
          <a
            href="https://www.linkedin.com/company/calcio-dev-llc"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-tertiary)] transition-colors hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>
          <!-- LinkedIn Personal -->
          <a
            href="https://www.linkedin.com/in/juanmzaragoza/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn Personal"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-tertiary)] transition-colors hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation columns -->
      {footerColumns.map((column) => (
        <div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">{column.title}</h3>
          <ul class="mt-3 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
                  {...(link.href.startsWith('http') && {
                    target: '_blank',
                    rel: 'noopener noreferrer',
                  })}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-[var(--border)] pt-8 text-sm text-[var(--text-tertiary)] md:flex-row">
      <div class="flex flex-col items-center gap-4 md:flex-row md:gap-6">
        <p>
          &copy; {currentYear} <span set:html={t('footer.copyright')} />
        </p>
        <div class="flex gap-4">
          <a
            href={getLocalizedPath(lang, '/privacy')}
            class="hover:text-[var(--text-primary)] transition-colors"
          >
            {t('footer.privacyPolicy')}
          </a>
          <a
            href={getLocalizedPath(lang, '/terms')}
            class="hover:text-[var(--text-primary)] transition-colors"
          >
            {t('footer.termsOfService')}
          </a>
        </div>
      </div>
      <p>
        {t('footer.builtWith')}{' '}
        <a
          href="https://astro.build"
          class="font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          Astro
        </a>
      </p>
    </div>
  </div>
</footer>
