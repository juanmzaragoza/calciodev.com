---
/**
 * Footer.astro — Site footer with navigation columns and social links
 */
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const footerColumns = [
  {
    title: t('footer.product'),
    links: [
      { label: t('nav.features'), href: getLocalizedPath(lang, '/#features') },
      { label: t('nav.pricing'), href: getLocalizedPath(lang, '/pricing') },
      { label: t('nav.caseStudies'), href: getLocalizedPath(lang, '/case-studies') },
    ],
  },
  {
    title: t('footer.resources'),
    links: [
      { label: t('nav.blog'), href: getLocalizedPath(lang, '/blog') },
      { label: t('footer.documentation'), href: getLocalizedPath(lang, '/docs') },
      { label: t('footer.rssFeed'), href: '/rss.xml' },
    ],
  },
  {
    title: t('footer.company'),
    links: [
      { label: t('nav.about'), href: getLocalizedPath(lang, '/about') },
      { label: 'GitHub', href: 'https://github.com/druedaro/astro-seo-theme' },
      { label: t('footer.license'), href: '/LICENSE' },
    ],
  },
];
---

<footer class="border-t border-[var(--border)] bg-[var(--bg)]">
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1">
        <a
          href={getLocalizedPath(lang, '/')}
          class="flex items-center gap-2 font-display text-lg font-bold"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-7 w-7 text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
          <span class="font-display text-xl font-bold tracking-tight">
            Astro
            <span class="text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)]">
              SEO
            </span>
          </span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
          The ultimate open-source Astro theme for B2B/SaaS marketing websites with advanced SEO.
        </p>

        <!-- Phone -->
        <a
          href="tel:+15551234567"
          class="mt-4 inline-flex items-center gap-2 text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
            />
          </svg>
          +1 (555) 123-4567
        </a>

        <!-- Social icons -->
        <div class="mt-4 flex items-center gap-3">
          <!-- X (Twitter) -->
          <a
            href="https://x.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X (Twitter)"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-tertiary)] transition-colors hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <!-- Facebook -->
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-tertiary)] transition-colors hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
          <!-- GitHub -->
          <a
            href="https://github.com/druedaro/astro-seo-theme"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-tertiary)] transition-colors hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
          <!-- Slack -->
          <a
            href="https://slack.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Slack"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-tertiary)] transition-colors hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zm1.271 0a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zm0 1.271a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zm10.124 2.521a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.52 2.521h-2.522V8.834zm-1.268 0a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zm-2.523 10.124a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.52v-2.523h2.52zm0-1.268a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.52 2.523h-6.313z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation columns -->
      {footerColumns.map((column) => (
        <div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">{column.title}</h3>
          <ul class="mt-3 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
                  {...(link.href.startsWith('http') && {
                    target: '_blank',
                    rel: 'noopener noreferrer',
                  })}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-[var(--border)] pt-8 text-sm text-[var(--text-tertiary)] md:flex-row">
      <div class="flex flex-col items-center gap-4 md:flex-row md:gap-6">
        <p>
          &copy; {currentYear} <span set:html={t('footer.copyright')} />
        </p>
        <div class="flex gap-4">
          <a
            href={getLocalizedPath(lang, '/privacy')}
            class="hover:text-[var(--text-primary)] transition-colors"
          >
            {t('footer.privacyPolicy')}
          </a>
          <a
            href={getLocalizedPath(lang, '/terms')}
            class="hover:text-[var(--text-primary)] transition-colors"
          >
            {t('footer.termsOfService')}
          </a>
        </div>
      </div>
      <p>
        {t('footer.builtWith')}{' '}
        <a
          href="https://astro.build"
          class="font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          Astro
        </a>
      </p>
    </div>
  </div>
</footer>
