const inner = icons[name] ?? '';
const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;
---

{
  tile ? (
    <span
      class:list={[
        'inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[var(--color-primary-50)] text-[var(--color-primary-600)]',
        className,
      ]}
      aria-hidden="true"
      set:html={svg}
    />
  ) : (
    <span class:list={[className]} aria-hidden="true" set:html={svg} />
  )
}
