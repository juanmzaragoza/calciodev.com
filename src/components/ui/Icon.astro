---
/**
 * Icon.astro — inline Lucide line icons (no dependency).
 * Renders inside a tinted rounded tile by default; pass tile={false} for a bare icon.
 */
interface Props {
  name: string;
  tile?: boolean;
  class?: string;
  size?: number;
}

