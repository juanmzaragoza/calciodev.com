---
import JsonLd from '../seo/JsonLd.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  description?: string;
  faqs: FaqItem[];
}

const {
  title = 'Frequently Asked Questions',
  description = 'Everything you need to know about the product and billing.',
  faqs,
} = Astro.props;

// Generate FAQPage schema data
const faqSchemaData = {
  items: faqs,
};
---

<section class="mx-auto max-w-4xl px-6 py-16 md:py-24" id="faq">
  <JsonLd type="FAQPage" data={faqSchemaData} />

  <div class="text-center mb-12">
    <h2 class="font-display text-3xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl">
      {title}
    </h2>
    {description && <p class="mt-4 text-lg text-[var(--text-secondary)]">{description}</p>}
  </div>

  <div class="space-y-4">
    {faqs.map((faq) => (
      <details class="group rounded-2xl border border-[var(--border)] bg-[var(--bg)] [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer items-center justify-between gap-4 p-6 font-semibold text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary-500)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg)]">
          <span class="text-lg">{faq.question}</span>
          <span class="ml-6 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--bg-secondary)] transition-transform duration-300 group-open:rotate-180">
            <svg
              class="h-4 w-4 text-[var(--text-secondary)]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="px-6 pb-6 text-[var(--text-secondary)] leading-relaxed">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  /* Smooth native animation for the dropdown content */
  details[open] summary ~ * {
    animation: fade-slide-down 0.3s ease-in-out;
  }

  @keyframes fade-slide-down {
    0% {
      opacity: 0;
      transform: translateY(-8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
