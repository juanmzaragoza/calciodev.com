---
/**
 * HeroSection.astro — Dynamic Hero Section for Landing Pages
 *
 * Features:
 * - Optimized for LCP (Largest Contentful Paint)
 * - Gradient text support
 * - Primary and secondary CTAs
 * - Optional top badge (e.g., "New Feature")
 */

interface Props {
  badge?: string;
  titleStart: string;
  titleHighlight: string;
  titleEnd?: string;
  description: string;
  primaryCtaText: string;
  primaryCtaHref: string;
  primaryCtaAriaLabel?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  secondaryCtaAriaLabel?: string;
}

const {
  badge,
  titleStart,
  titleHighlight,
  titleEnd = '',
  description,
  primaryCtaText,
  primaryCtaHref,
  primaryCtaAriaLabel,
  secondaryCtaText,
  secondaryCtaHref,
  secondaryCtaAriaLabel,
} = Astro.props;
---

<section class="flex flex-col items-center justify-center px-6 py-20 text-center md:py-32">
  {badge && (
    <div class="mb-8 inline-flex items-center rounded-full border border-[var(--border)] bg-[var(--bg-secondary)] px-3 py-1 text-sm font-medium text-[var(--text-secondary)]">
      <span class="mr-2 flex h-2 w-2 rounded-full bg-[var(--color-primary-500)]"></span>
      {badge}
    </div>
  )}

  <h1 class="mx-auto max-w-4xl font-display text-5xl font-extrabold leading-tight tracking-tight md:text-7xl">
    {titleStart}{' '}
    <span class="bg-gradient-to-r from-[var(--color-primary-400)] to-[var(--color-accent-400)] bg-clip-text text-transparent">
      {titleHighlight}
    </span>
    {titleEnd && ` ${titleEnd}`}
  </h1>

  <p class="mx-auto mt-6 max-w-2xl text-lg text-[var(--text-secondary)] md:text-xl">
    {description}
  </p>

  <div class="mt-10 flex flex-col gap-4 sm:flex-row">
    <a
      href={primaryCtaHref}
      aria-label={primaryCtaAriaLabel || primaryCtaText}
      class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--color-primary-600)] px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-[var(--color-primary-600)]/25 transition-all hover:-translate-y-0.5 hover:bg-[var(--color-primary-700)] hover:shadow-xl active:scale-95 focus-visible:ring-2 focus-visible:ring-[var(--color-primary-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg)]"
    >
      {primaryCtaText}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>

    {secondaryCtaText && secondaryCtaHref && (
      <a
        href={secondaryCtaHref}
        aria-label={secondaryCtaAriaLabel || secondaryCtaText}
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--border)] px-8 py-3.5 text-sm font-semibold text-[var(--text-primary)] transition-all hover:-translate-y-0.5 hover:border-[var(--border-hover)] hover:bg-[var(--bg-secondary)] hover:shadow-md active:scale-95 focus-visible:ring-2 focus-visible:ring-[var(--border)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg)]"
      >
        {secondaryCtaText}
      </a>
    )}
  </div>
</section>
