---
/**
 * Logo.astro — CALCIO brand logo (SVG + text fallback)
 *
 * Usage:
 * <Logo variant="full" /> → Full logo from SVG
 * <Logo variant="text" /> → "CALCIO" text only (fallback)
 */

import logoSvg from '../assets/logos/calcio-logo.svg';

interface Props {
  variant?: 'full' | 'text';
  className?: string;
  width?: number;
  height?: number;
}

const { variant = 'full', className = '', width = 160, height = 40 } = Astro.props;
---

{variant === 'full' && (
  <img
    src={logoSvg}
    alt="CALCIO"
    width={width}
    height={height}
    class={`h-auto max-h-8 w-auto ${className}`}
    loading="lazy"
  />
)}

{variant === 'text' && (
  <span class={`font-bold text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)] ${className}`}>
    CALCIO
  </span>
)}
