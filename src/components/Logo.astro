---
/**
 * Logo.astro — CALCIO brand logo (SVG from public folder)
 *
 * Usage:
 * <Logo variant="full" /> → Full logo SVG
 * <Logo variant="text" /> → "CALCIO" text fallback
 */

interface Props {
  variant?: 'full' | 'text';
  className?: string;
}

const { variant = 'full', className = '' } = Astro.props;
---

{variant === 'full' && (
  <img
    src="/logos/calcio-logo.svg"
    alt="CALCIO"
    class={`h-auto max-h-8 w-auto ${className}`}
    loading="lazy"
  />
)}

{variant === 'text' && (
  <span class={`font-bold text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)] ${className}`}>
    CALCIO
  </span>
)}
