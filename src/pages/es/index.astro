---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import HeroSection from '../../components/marketing/HeroSection.astro';
import LogoCloud from '../../components/marketing/LogoCloud.astro';
import BentoGrid from '../../components/marketing/BentoGrid.astro';
import FaqAccordion from '../../components/marketing/FaqAccordion.astro';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://astro-seo-theme.vercel.app';
---

<BaseLayout
  title="Astro SEO Theme - El Tema B2B/SaaS de Marketing Definitivo"
  description="Tema open-source en Astro con optimización SEO, GEO y AEO avanzada. Construido para empresas SaaS y webs de marketing B2B. Lighthouse 100/100."
  appendSiteName={false}
>
  <Fragment slot="head">
    <JsonLd
      type="WebSite"
      data={{
        name: 'Astro SEO Theme',
        url: siteUrl,
        description:
          'El tema open-source definitivo de Astro para sitios web de marketing B2B/SaaS.',
        searchUrl: `${siteUrl}/search`,
      }}
    />
    <JsonLd
      type="Organization"
      data={{
        name: 'Astro SEO Theme',
        url: siteUrl,
        description:
          'Tema open-source de Astro con optimización SEO avanzada para sitios web B2B y SaaS.',
      }}
    />
  </Fragment>
  <Header slot="header" />

  <HeroSection
    badge="v1.0 disponible"
    titleStart="El Tema SEO"
    titleHighlight="Que Tu SaaS Merece"
    description="SEO técnico avanzado, optimización GEO y AEO incluidos. Lighthouse 100/100. Construido con Astro, Tailwind y React."
    primaryCtaText="Empezar en GitHub"
    primaryCtaHref="https://github.com/druedaro/astro-seo-theme"
    primaryCtaAriaLabel="Ver Astro SEO Theme en GitHub"
    secondaryCtaText="Leer la Documentación"
    secondaryCtaHref="/es/docs"
  />

  <LogoCloud
    title="Con la confianza de equipos innovadores"
    logos={[
      {
        name: 'Vercel',
        src: '/logos/vercel.svg',
        className: 'dark:invert',
      },
      {
        name: 'Astro',
        src: '/logos/astro-dark.svg',
        darkSrc: '/logos/astro-light.svg',
      },
      {
        name: 'Tailwind',
        src: '/logos/tailwind.svg',
      },
      { name: 'React', src: '/logos/react.svg' },
    ]}
  />

  <BentoGrid
    title="Todo lo que necesitas para posicionar mejor"
    subtitle="Construido desde cero para SEO técnico y motores de búsqueda con IA."
    items={[
      {
        title: 'Cero JS por Defecto',
        description:
          'Envía menos JavaScript y consigue puntuaciones perfectas de 100/100 en Lighthouse. React solo se carga para islas interactivas cuando es absolutamente necesario.',
        colSpan: 2,
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>',
      },
      {
        title: 'JSON-LD Automático',
        description:
          'Generación dinámica de datos estructurados Schema.org para Artículos, FAQs, Organizaciones y Breadcrumbs.',
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>',
      },
      {
        title: 'Preparado para GEO y AEO',
        description:
          'Estructuras de contenido optimizadas y HTML semántico diseñado para IA Generativa y Fragmentos Destacados.',
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" /></svg>',
      },
      {
        title: 'Soporte i18n',
        description: 'Soporte nativo para múltiples idiomas con etiquetas hreflang automáticas.',
        colSpan: 2,
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" /></svg>',
      },
    ]}
  />

  <FaqAccordion
    title="Preguntas Frecuentes"
    faqs={[
      {
        question: '¿Astro SEO Theme es realmente gratis?',
        answer:
          '¡Sí! Es 100% open-source y está publicado bajo la licencia MIT. Puedes usarlo para proyectos personales y comerciales sin necesidad de atribución (aunque siempre se agradece).',
      },
      {
        question: '¿Necesito saber React para usarlo?',
        answer:
          'Para nada. Todo el núcleo está construido con Astro y HTML/CSS estándar. React solo se usa para componentes altamente interactivos (como el toggle de Precios y el switch de Modo Oscuro) usando Astro Islands, lo que significa 0kb de JS para el resto del sitio.',
      },
      {
        question: '¿Cómo se genera el JSON-LD?',
        answer:
          'Hemos construido componentes Astro personalizados que leen automáticamente tu contenido (como el frontmatter del Blog o el array de FAQs) y generan scripts JSON-LD de Schema.org válidos en el `<head>` del documento. Esto ayuda a Google a entender la estructura de tu contenido al instante.',
      },
      {
        question: '¿Puedo alojar esto en Vercel o Netlify?',
        answer:
          'Por supuesto. Astro compila a HTML/CSS estático (SSG) por defecto, lo que significa que puedes desplegarlo en cualquier host estático como Vercel, Netlify, Cloudflare Pages, o incluso GitHub Pages sin ninguna configuración.',
      },
    ]}
  />

  <Footer slot="footer" />
</BaseLayout>
