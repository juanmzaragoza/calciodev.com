---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import Icon from '../../components/ui/Icon.astro';

const title = 'Auditorías Técnicas y Rescate de Software';
const description = 'Tu empresa creció. Tus sistemas no. Auditamos deuda técnica, rescatamos proyectos estancados y proporcionamos liderazgo de CTO fraccionario para empresas B2B en etapa de crecimiento.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://calciodev.com';
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <JsonLd
      type="ProfessionalService"
      data={{
        name: 'CALCIO',
        url: `${siteUrl}/es/`,
        description:
          'Auditorías técnicas, rescate de proyectos y liderazgo de CTO fraccionario para empresas B2B en etapa de crecimiento.',
        logo: `${siteUrl}/logos/calcio-logo.png`,
        sameAs: ['https://www.linkedin.com/company/calcio-dev-llc'],
        areaServed: ['Estados Unidos', 'Latinoamérica'],
        knowsAbout: [
          'Auditoría de arquitectura de software',
          'Deuda técnica',
          'Rescate de proyectos',
          'CTO fraccionario',
          'Desarrollo de software a medida',
          'Analytics embebido',
          'Automatización de QA',
          'IA aplicada',
        ],
        founder: {
          name: 'Juan Manuel Zaragoza',
          jobTitle: 'Fundador',
          url: 'https://juanmazaragoza.com',
          sameAs: ['https://www.linkedin.com/in/juanmzaragoza/'],
        },
        makesOffer: {
          name: 'Auditoría de Arquitectura & Deuda Técnica',
          description: 'Auditoría técnica de dos semanas y alcance fijo con un roadmap priorizado.',
          priceCurrency: 'USD',
          minPrice: 4000,
          maxPrice: 6000,
          url: `${siteUrl}/es/audit/`,
        },
      }}
    />
  </Fragment>
  <Header slot="header" />
  <!-- Hero -->
  <section class="relative overflow-hidden bg-[#0d0d0d] pt-24 pb-20 md:pt-32 md:pb-32">
    <img
      src="/hero/home-hero.webp"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-right select-none"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0d0d0d] via-[#0d0d0d]/90 to-[#0d0d0d]/40 md:to-transparent"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="max-w-xl">
        <div class="mb-6 inline-flex items-center rounded-full border border-white/15 bg-white/5 px-3 py-1 text-sm font-medium text-white/70 backdrop-blur-sm">
          <span class="mr-2 flex h-2 w-2 rounded-full bg-[var(--color-primary-400)]"></span>
          Auditorías técnicas · Rescate de proyectos · CTO fraccionario
        </div>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white mb-6">
          Tu empresa creció.<br />
          <span class="bg-gradient-to-r from-[var(--color-primary-400)] to-[var(--color-accent-400)] bg-clip-text text-transparent">Tus sistemas no.</span>
        </h1>
        <p class="text-lg md:text-xl text-white/75 mb-8 max-w-lg">
          Rescatamos infraestructura inestable, auditamos deuda técnica y proporcionamos liderazgo de CTO fraccionario para empresas B2B en etapa de crecimiento.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="https://calendly.com/juanmanuelzaragoza/30min"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3 bg-[var(--color-primary-600)] text-white font-semibold rounded-lg hover:bg-[var(--color-primary-700)] transition-colors"
          >
            Reservar Llamada (30 min)
          </a>
          <a
            href="/es/audit/"
            class="inline-flex items-center justify-center px-6 py-3 border border-white/20 text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
          >
            Ver la Auditoría
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trusted by -->
  <section class="border-t border-b border-[var(--border)] bg-[var(--bg-secondary)] py-8 md:py-12">
    <div class="mx-auto max-w-7xl px-6">
      <p class="text-center text-sm text-[var(--text-secondary)] mb-8">
        Confianza de equipos en bienes raíces, ticketing, plataformas de datos, marketing y gobierno
      </p>
      <div class="mx-auto max-w-4xl rounded-2xl border border-[var(--border)] bg-white p-6 shadow-sm md:p-8">
        <div class="grid grid-cols-2 items-center gap-6 sm:grid-cols-2 md:grid-cols-4 md:gap-8">
          <img src="/logos/clients/datakimia.webp" alt="Datakimia" loading="lazy" class="mx-auto max-h-8 w-auto max-w-[130px] object-contain" />
          <img src="/logos/clients/gcba.webp" alt="Buenos Aires Ciudad" loading="lazy" class="mx-auto max-h-10 w-auto max-w-[120px] object-contain" />
          <img src="/logos/clients/casa-domo.webp" alt="Casa Domo" loading="lazy" class="mx-auto max-h-9 w-auto max-w-[130px] object-contain" />
          <img src="/logos/clients/guruxy.webp" alt="Guruxy" loading="lazy" class="mx-auto max-h-8 w-auto max-w-[130px] object-contain" />
        </div>
      </div>
    </div>
  </section>

  <!-- Problems We Solve -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-12 text-center">
        Problemas que resolvemos
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="p-6 border border-[var(--border)] rounded-lg">
          <Icon name="ghost" class="mb-4" />
          <p class="text-[var(--text-primary)] font-semibold mb-2">El desarrollador anterior se fue</p>
          <p class="text-[var(--text-secondary)] text-sm">y el proyecto está a mitad de camino, sin que nadie entienda la arquitectura.</p>
        </div>
        <div class="p-6 border border-[var(--border)] rounded-lg">
          <Icon name="lock" class="mb-4" />
          <p class="text-[var(--text-primary)] font-semibold mb-2">No somos dueños de nuestro código</p>
          <p class="text-[var(--text-secondary)] text-sm">El proveedor anterior nos bloqueó. Necesitamos control de nuestra infraestructura.</p>
        </div>
        <div class="p-6 border border-[var(--border)] rounded-lg">
          <Icon name="dice-5" class="mb-4" />
          <p class="text-[var(--text-primary)] font-semibold mb-2">Cada release es una apuesta</p>
          <p class="text-[var(--text-secondary)] text-sm">Sin tests, sin CI/CD, deployments manuales. Nos da miedo hacer ship.</p>
        </div>
        <div class="p-6 border border-[var(--border)] rounded-lg">
          <Icon name="map" class="mb-4" />
          <p class="text-[var(--text-primary)] font-semibold mb-2">Necesitamos escalar, pero primero...</p>
          <p class="text-[var(--text-secondary)] text-sm">debemos saber qué está roto. Necesitamos un roadmap, no una reescritura.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 md:py-24 bg-[var(--bg-secondary)]">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-12 text-center">
        Qué hacemos
      </h2>

      <div class="mb-16">
        <h3 class="text-xl font-bold text-[var(--color-primary-600)] mb-6">Build (Construir)</h3>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <Icon name="code" />
            <div>
              <h4 class="font-semibold text-[var(--text-primary)] mb-2">Software Personalizado & Integraciones</h4>
              <p class="text-sm text-[var(--text-secondary)]">Sistemas de medición, APIs, integraciones con herramientas existentes (ERP, CRM, legacy), pagos con Stripe.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <Icon name="life-buoy" />
            <div>
              <h4 class="font-semibold text-[var(--text-primary)] mb-2">Rescate de Proyectos</h4>
              <p class="text-sm text-[var(--text-secondary)]">Tomar un proyecto estancado, recuperar control del código e infraestructura, hacer ship a producción.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="mb-16">
        <h3 class="text-xl font-bold text-[var(--color-primary-600)] mb-6">Connect (Conectar)</h3>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <Icon name="workflow" />
            <div>
              <h4 class="font-semibold text-[var(--text-primary)] mb-2">Automatización & Integraciones</h4>
              <p class="text-sm text-[var(--text-secondary)]">Procesos que se ejecutan solos: bots de WhatsApp y Manychat, Apps Script, integraciones de herramientas.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="mb-16">
        <h3 class="text-xl font-bold text-[var(--color-primary-600)] mb-6">Clarify (Aclarar)</h3>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <Icon name="bar-chart-3" />
            <div>
              <h4 class="font-semibold text-[var(--text-primary)] mb-2">Analytics Embebidos & BI</h4>
              <p class="text-sm text-[var(--text-secondary)]">Dashboards dentro de tu producto, con aislamiento por cliente. BigQuery, Superset, reportes automatizados.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <Icon name="shield-check" />
            <div>
              <h4 class="font-semibold text-[var(--text-primary)] mb-2">Automatización QA & Confianza en Release</h4>
              <p class="text-sm text-[var(--text-secondary)]">Estrategia de testing desde cero. E2E con Playwright, gates de calidad post-deploy, menos sorpresas.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="mb-16">
        <h3 class="text-xl font-bold text-[var(--color-primary-600)] mb-6">Lead (Liderar)</h3>
        <div class="flex gap-4">
          <Icon name="compass" />
          <div>
            <h4 class="font-semibold text-[var(--text-primary)] mb-2">CTO Fraccionario</h4>
            <p class="text-sm text-[var(--text-secondary)]">Liderazgo técnico sin contratar tiempo completo. Roadmap, decisiones de arquitectura, coordinación de equipo, hiring.</p>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href="/es/services/" class="inline-flex items-center gap-2 text-[var(--color-primary-600)] font-semibold hover:underline">
          Ver todos los servicios →
        </a>
      </div>
    </div>
  </section>

  <!-- Anchor Offer -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-2xl px-6 border border-[var(--border)] rounded-lg p-8 md:p-12 bg-[var(--bg-secondary)]">
      <h2 class="text-3xl font-bold text-[var(--text-primary)] mb-6">
        Auditoría de Arquitectura & Deuda Técnica
      </h2>
      <p class="text-[var(--text-secondary)] mb-8">
        Dos semanas. Alcance fijo. Un mapa completo de qué está roto y un roadmap priorizado para arreglarlo.
      </p>

      <div class="grid md:grid-cols-2 gap-6 mb-8">
        <div>
          <p class="text-sm text-[var(--text-tertiary)] mb-1">Inversión</p>
          <p class="text-3xl font-bold text-[var(--color-primary-600)]">USD 4.000–6.000</p>
          <p class="text-xs text-[var(--text-tertiary)] mt-2">Acreditado hacia un engagement futuro</p>
        </div>
        <div>
          <p class="text-sm text-[var(--text-tertiary)] mb-1">Revisamos</p>
          <ul class="text-sm text-[var(--text-primary)] space-y-1">
            <li>• Arquitectura & escalabilidad</li>
            <li>• Seguridad (auth, reglas BaaS, secrets)</li>
            <li>• Testing & CI/CD</li>
            <li>• Dependencias & riesgo de upgrade</li>
            <li>• Multi-tenancy & aislamiento</li>
          </ul>
        </div>
      </div>

      <a
        href="https://calendly.com/juanmanuelzaragoza/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-6 py-3 bg-[var(--color-primary-600)] text-white font-semibold rounded-lg hover:bg-[var(--color-primary-700)] transition-colors w-full md:w-auto text-center"
      >
        Comenzar Auditoría
      </a>
    </div>
  </section>

  <!-- Case Studies -->
  <section class="py-16 md:py-24 bg-[var(--bg-secondary)]">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-12 text-center">
        Trabajo reciente
      </h2>

      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <!-- Listing Los Cabos -->
        <a href="/es/case-studies/listing-los-cabos/" class="group p-6 border border-[var(--border)] rounded-lg hover:bg-[var(--bg)] transition-colors">
          <div class="flex items-start justify-between mb-4">
            <h3 class="text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--color-primary-600)]">
              Listing Los Cabos
            </h3>
            <span class="text-xs font-semibold text-[var(--color-primary-600)] bg-[var(--color-primary-600)]/10 px-2 py-1 rounded">Bienes Raíces</span>
          </div>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            Rescatamos una plataforma React + Firebase a mitad de camino, agregamos suscripciones con Stripe y seguridad, ahora sirve a 2 ciudades desde un codebase.
          </p>
          <div class="flex gap-3 flex-wrap text-xs text-[var(--text-tertiary)]">
            <span>6 meses a producción</span>
            <span>•</span>
            <span>2 ciudades, 1 codebase</span>
            <span>•</span>
            <span>3 planes de suscripción</span>
          </div>
        </a>

        <!-- Ticketing Platform -->
        <a href="/es/case-studies/ticketing-platform/" class="group p-6 border border-[var(--border)] rounded-lg hover:bg-[var(--bg)] transition-colors">
          <div class="flex items-start justify-between mb-4">
            <h3 class="text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--color-primary-600)]">
              Ticketing de Alto Volumen
            </h3>
            <span class="text-xs font-semibold text-[var(--color-primary-600)] bg-[var(--color-primary-600)]/10 px-2 py-1 rounded">QA</span>
          </div>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            Construimos estrategia de testing desde cero: E2E con Playwright, tests de integración backend, gates automatizados. Releases pasaron de días a minutos.
          </p>
          <div class="flex gap-3 flex-wrap text-xs text-[var(--text-tertiary)]">
            <span>91 tests E2E</span>
            <span>•</span>
            <span>616 tests integración</span>
            <span>•</span>
            <span>3 gateways de pago</span>
          </div>
        </a>

        <!-- Data Platform -->
        <a href="/es/case-studies/data-platform/" class="group p-6 border border-[var(--border)] rounded-lg hover:bg-[var(--bg)] transition-colors">
          <div class="flex items-start justify-between mb-4">
            <h3 class="text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--color-primary-600)]">
              Plataforma de Datos Multi-Tenant
            </h3>
            <span class="text-xs font-semibold text-[var(--color-primary-600)] bg-[var(--color-primary-600)]/10 px-2 py-1 rounded">Analytics</span>
          </div>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            Plataforma de datos full-stack con aislamiento por cliente, dashboards Superset embebidos y data agents. Cada cliente ve solo sus datos.
          </p>
          <div class="flex gap-3 flex-wrap text-xs text-[var(--text-tertiary)]">
            <span>3 upgrades Superset en 30 días</span>
            <span>•</span>
            <span>4.400 archivos merged</span>
            <span>•</span>
            <span>3 tenants aislados</span>
          </div>
        </a>

        <!-- Government -->
        <a href="/es/case-studies/government-systems/" class="group p-6 border border-[var(--border)] rounded-lg hover:bg-[var(--bg)] transition-colors">
          <div class="flex items-start justify-between mb-4">
            <h3 class="text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--color-primary-600)]">
              Sistemas de Gobierno Ciudad
            </h3>
            <span class="text-xs font-semibold text-[var(--color-primary-600)] bg-[var(--color-primary-600)]/10 px-2 py-1 rounded">Liderazgo</span>
          </div>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            Lead técnico para sistemas de evaluación de empleados, dispensación de medicamentos y participación cívica sirviendo decenas de miles de usuarios.
          </p>
          <div class="flex gap-3 flex-wrap text-xs text-[var(--text-tertiary)]">
            <span>7 años</span>
            <span>•</span>
            <span>12 sistemas</span>
            <span>•</span>
            <span>5 tech stacks</span>
          </div>
        </a>
      </div>

      <div class="text-center">
        <a href="/es/case-studies/" class="inline-flex items-center gap-2 text-[var(--color-primary-600)] font-semibold hover:underline">
          Ver los 6 casos →
        </a>
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-12 text-center">
        Cómo trabajamos
      </h2>

      <div class="grid md:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-primary-600)] text-white font-bold mx-auto mb-4">
            1
          </div>
          <h3 class="font-semibold text-[var(--text-primary)] mb-2">Llamada gratis 30 min</h3>
          <p class="text-sm text-[var(--text-secondary)]">Entendemos tu situación, restricciones y objetivos.</p>
        </div>

        <div class="text-center">
          <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-primary-600)] text-white font-bold mx-auto mb-4">
            2
          </div>
          <h3 class="font-semibold text-[var(--text-primary)] mb-2">Auditoría alcance fijo</h3>
          <p class="text-sm text-[var(--text-secondary)]">2 semanas, 1 deliverable, 1 precio. Un roadmap en el que puedes actuar.</p>
        </div>

        <div class="text-center">
          <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-primary-600)] text-white font-bold mx-auto mb-4">
            3
          </div>
          <h3 class="font-semibold text-[var(--text-primary)] mb-2">Build o CTO fraccionario</h3>
          <p class="text-sm text-[var(--text-secondary)]">Updates semanales. Progreso transparente. Cambios de alcance por escrito.</p>
        </div>

        <div class="text-center">
          <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-primary-600)] text-white font-bold mx-auto mb-4">
            4
          </div>
          <h3 class="font-semibold text-[var(--text-primary)] mb-2">Es tuyo</h3>
          <p class="text-sm text-[var(--text-secondary)]">Código, infraestructura, cuentas, documentación. Todo tuyo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="py-16 md:py-24 bg-[var(--bg-secondary)]">
    <div class="mx-auto max-w-2xl px-6">
      <blockquote class="text-center">
        <p class="text-lg text-[var(--text-primary)] mb-6">
          "Juan Manuel nos ayudó a renovar completamente nuestra plataforma — desde diseño hasta seguridad hasta suscripciones. No solo resolvió los problemas existentes sino que posicionó la plataforma para crecimiento futuro. Ahora tenemos control total de un sistema que realmente funciona."
        </p>
        <div class="mt-6 flex items-center justify-center gap-3">
          <img
            src="/testimonials/julio-cesar-perez.webp"
            alt="Julio César Pérez"
            width="56"
            height="56"
            loading="lazy"
            class="h-14 w-14 rounded-full object-cover border border-[var(--border)]"
          />
          <div class="text-left">
            <p class="font-semibold text-[var(--text-primary)]">Julio César Pérez</p>
            <p class="text-sm text-[var(--text-tertiary)]">Project Leader · Listing Los Cabos, Mexico City</p>
          </div>
        </div>
        <p class="text-xs text-[var(--color-primary-600)] mt-4">
          <a href="https://youtu.be/cTap4d1NMDY" target="_blank" rel="noopener noreferrer" class="hover:underline">
            Ver video →
          </a>
        </p>
      </blockquote>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-2xl px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-12 text-center">
        Preguntas
      </h2>

      <div class="space-y-6">
        <details class="group p-6 border border-[var(--border)] rounded-lg cursor-pointer">
          <summary class="font-semibold text-[var(--text-primary)] flex justify-between items-center">
            ¿Trabajan en horarios de zonas horarias estadounidenses?
            <span class="group-open:rotate-180 transition-transform">+</span>
          </summary>
          <p class="text-[var(--text-secondary)] mt-4 text-sm">
            Sí. Operamos en UTC-5 (equivalente a Hora Estándar del Este de EE.UU.) y nos sobreponemos con horarios de negocios estadounidenses durante todo el año.
          </p>
        </details>

        <details class="group p-6 border border-[var(--border)] rounded-lg cursor-pointer">
          <summary class="font-semibold text-[var(--text-primary)] flex justify-between items-center">
            ¿Quién es dueño del código?
            <span class="group-open:rotate-180 transition-transform">+</span>
          </summary>
          <p class="text-[var(--text-secondary)] mt-4 text-sm">
            Tú. Eres dueño de todo el código, infraestructura, cuentas y documentación. Transferimos todo a tu control al final de cada engagement.
          </p>
        </details>

        <details class="group p-6 border border-[var(--border)] rounded-lg cursor-pointer">
          <summary class="font-semibold text-[var(--text-primary)] flex justify-between items-center">
            ¿Y si ya tenemos desarrolladores?
            <span class="group-open:rotate-180 transition-transform">+</span>
          </summary>
          <p class="text-[var(--text-secondary)] mt-4 text-sm">
            Trabajamos al lado de tu equipo. Podemos mentorar, liderar decisiones de arquitectura, o manejar el camino crítico mientras tu equipo maneja trabajo paralelo. La auditoría aclara qué tiene sentido.
          </p>
        </details>

        <details class="group p-6 border border-[var(--border)] rounded-lg cursor-pointer">
          <summary class="font-semibold text-[var(--text-primary)] flex justify-between items-center">
            ¿Cómo se fija el precio de la auditoría?
            <span class="group-open:rotate-180 transition-transform">+</span>
          </summary>
          <p class="text-[var(--text-secondary)] mt-4 text-sm">
            Fijo: USD 4.000–6.000 para una auditoría de 2 semanas, dependiendo del tamaño y complejidad de tu codebase. La tarifa se acredita hacia cualquier engagement futuro.
          </p>
        </details>

        <details class="group p-6 border border-[var(--border)] rounded-lg cursor-pointer">
          <summary class="font-semibold text-[var(--text-primary)] flex justify-between items-center">
            ¿Firman NDAs?
            <span class="group-open:rotate-180 transition-transform">+</span>
          </summary>
          <p class="text-[var(--text-secondary)] mt-4 text-sm">
            Sí. NDAs mutuales estándar son parte de cada engagement.
          </p>
        </details>

        <details class="group p-6 border border-[var(--border)] rounded-lg cursor-pointer">
          <summary class="font-semibold text-[var(--text-primary)] flex justify-between items-center">
            ¿Pueden trabajar con nuestro stack existente?
            <span class="group-open:rotate-180 transition-transform">+</span>
          </summary>
          <p class="text-[var(--text-secondary)] mt-4 text-sm">
            Especializamos en Node.js, Next.js, React, NestJS, Python, PostgreSQL, GCP y AWS, pero hemos trabajado con Laravel, Angular, Java, .NET y muchos otros stacks. Cuéntanos qué usas y te diremos.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 md:py-24 bg-[var(--color-primary-600)] text-white">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        ¿Listo para arreglar tus sistemas?
      </h2>
      <p class="text-lg mb-8 opacity-95">
        Reserva una llamada de evaluación técnica de 30 minutos. Sin pitch, sin sorpresas — solo una conversación sobre qué está roto y qué es posible.
      </p>
      <a
        href="https://calendly.com/juanmanuelzaragoza/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-8 py-4 bg-white text-[var(--color-primary-600)] font-semibold rounded-lg hover:bg-[var(--bg)] transition-colors"
      >
        Reservar Llamada
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
