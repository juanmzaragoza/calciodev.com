---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PricingTable from '../../components/marketing/PricingTable.tsx';
import type { PricingTier } from '../../components/marketing/PricingTable.tsx';

const pricingTiers: PricingTier[] = [
  {
    name: 'Starter',
    description: 'Perfecto para startups en fase inicial y equipos pequeños que comienzan con SEO.',
    monthlyPrice: 29,
    annualPrice: 24,
    features: [
      'Hasta 5 miembros del equipo',
      'Analítica SEO básica',
      '1.000 generaciones IA/mes',
      'Soporte comunidad',
      'Integraciones estándar',
    ],
    ctaText: 'Empezar gratis',
    ctaHref: '/es/signup',
  },
  {
    name: 'Pro',
    description:
      'Funciones avanzadas para empresas SaaS en crecimiento que necesitan escala y rendimiento.',
    monthlyPrice: 99,
    annualPrice: 79,
    isPopular: true,
    features: [
      'Miembros ilimitados',
      'Analítica GEO y AEO avanzada',
      '10.000 generaciones IA/mes',
      'Soporte email prioritario',
      'Dominios personalizados',
      'Integraciones avanzadas',
    ],
    ctaText: 'Prueba 14 días gratis',
    ctaHref: '/es/signup',
  },
  {
    name: 'Enterprise',
    description:
      'Soluciones personalizadas para grandes organizaciones con necesidades de marketing complejas.',
    monthlyPrice: 299,
    annualPrice: 239,
    features: [
      'Todo ilimitado',
      'Entrenamiento de modelo IA personalizado',
      'Gestor de éxito dedicado',
      'Soporte telefónico 24/7',
      'SSO y seguridad avanzada',
      'SLA personalizado',
    ],
    ctaText: 'Contactar Ventas',
    ctaHref: '/es/contact',
  },
];
---

<BaseLayout
  title="Precios"
  description="Precios simples y transparentes para equipos de todos los tamaños. Empieza gratis, actualiza cuando necesites funciones SEO avanzadas."
>
  <Header slot="header" />

  <PricingTable
    client:load
    title="Precios simples y transparentes"
    subtitle="Sin costes ocultos. Sin cargos sorpresa. Cancela en cualquier momento."
    tiers={pricingTiers}
  />

  <Footer slot="footer" />
</BaseLayout>
