---
import { getCollection } from 'astro:content';
import CaseStudyList from '../../../layouts/CaseStudyList.astro';

// Get all non-draft case studies, sorted by date descending
const caseStudies = (await getCollection('case-studies'))
  .filter((study) => !study.data.draft && study.id.startsWith('es/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<CaseStudyList
  title="Casos de Éxito"
  description="Descubre cómo las principales empresas B2B SaaS utilizan nuestras soluciones para escalar su crecimiento y dominar las búsquedas orgánicas."
  caseStudies={caseStudies}
  basePath="/es/case-studies/"
/>
