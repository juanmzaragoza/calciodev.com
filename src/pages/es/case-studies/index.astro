---
import { getCollection } from 'astro:content';
import CaseStudyList from '../../../layouts/CaseStudyList.astro';

// Get all non-draft case studies, sorted by date descending
const caseStudies = (await getCollection('case-studies'))
  .filter((study) => !study.data.draft && study.id.startsWith('es/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<CaseStudyList
  title="Casos de Estudio"
  description="Proyectos reales: plataformas rescatadas, testing construido desde cero, sistemas de datos multi-cliente y años de software crítico del sector público. Esto hicimos y esto cambió."
  caseStudies={caseStudies}
  basePath="/es/case-studies/"
/>
