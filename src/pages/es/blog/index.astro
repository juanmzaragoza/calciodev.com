---
import { getCollection } from 'astro:content';
import BlogList from '../../../layouts/BlogList.astro';

// Get all non-draft posts, sorted by date descending
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.id.startsWith('es/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BlogList
  title="Nuestro Blog"
  description="Reflexiones, ideas y estrategias sobre B2B SaaS, SEO técnico y cómo construir sitios web de marketing de alto rendimiento."
  posts={posts}
  basePath="/es/blog/"
/>
