---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PricingTable from '../components/marketing/PricingTable.tsx';
import type { PricingTier } from '../components/marketing/PricingTable.tsx';

const pricingTiers: PricingTier[] = [
  {
    name: 'Starter',
    description: 'Perfect for early-stage startups and small teams getting started with SEO.',
    monthlyPrice: 29,
    annualPrice: 24,
    features: [
      'Up to 5 team members',
      'Basic SEO analytics',
      '1,000 AI generations/month',
      'Community support',
      'Standard integrations',
    ],
    ctaText: 'Start for free',
    ctaHref: '/signup',
  },
  {
    name: 'Pro',
    description: 'Advanced features for growing SaaS companies that need scale and performance.',
    monthlyPrice: 99,
    annualPrice: 79,
    isPopular: true,
    features: [
      'Unlimited team members',
      'Advanced GEO & AEO analytics',
      '10,000 AI generations/month',
      'Priority email support',
      'Custom domains',
      'Advanced integrations',
    ],
    ctaText: 'Start 14-day trial',
    ctaHref: '/signup',
  },
  {
    name: 'Enterprise',
    description: 'Custom solutions for large organizations with complex marketing needs.',
    monthlyPrice: 299,
    annualPrice: 239,
    features: [
      'Unlimited everything',
      'Custom AI model training',
      'Dedicated success manager',
      '24/7 phone support',
      'SSO & advanced security',
      'Custom SLA',
    ],
    ctaText: 'Contact Sales',
    ctaHref: '/contact',
  },
];
---

<BaseLayout
  title="Pricing"
  description="Simple, transparent pricing for teams of all sizes. Start for free, upgrade when you need advanced SEO features."
>
  <Header slot="header" />

  <PricingTable
    client:load
    title="Simple, transparent pricing"
    subtitle="No hidden fees. No surprise charges. Cancel anytime."
    tiers={pricingTiers}
  />

  <Footer slot="footer" />
</BaseLayout>
