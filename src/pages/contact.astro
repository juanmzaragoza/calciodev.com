---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const title = 'Contact';
const description = 'Book a 30-minute technical call, or reach us by email. We work in UTC-5, overlapping US business hours, in English and Spanish.';
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <main class="mx-auto max-w-3xl px-6 py-20 md:py-28">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-[var(--text-primary)] mb-6">
        Let's talk about your systems
      </h1>
      <p class="text-lg text-[var(--text-secondary)]">
        The best place to start is a 30-minute call. No pitch, no surprises — just a conversation about what's broken and what's possible.
      </p>
    </div>

    <!-- Primary: Calendly -->
    <div class="border-2 border-[var(--color-primary-600)] rounded-lg p-8 text-center mb-8">
      <h2 class="text-xl font-bold text-[var(--text-primary)] mb-2">Book a 30-min call</h2>
      <p class="text-sm text-[var(--text-secondary)] mb-6">Pick a time that works for you. We'll come prepared.</p>
      <a href="https://calendly.com/juanmanuelzaragoza/30min" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 bg-[var(--color-primary-600)] text-white font-semibold rounded-lg hover:bg-[var(--color-primary-700)] transition-colors">
        Open the calendar
      </a>
    </div>

    <!-- Secondary options -->
    <div class="grid sm:grid-cols-2 gap-6">
      <div class="p-6 border border-[var(--border)] rounded-lg">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-[var(--text-tertiary)] mb-2">Email</h3>
        <a href="mailto:hello@calciodev.com" class="text-lg font-semibold text-[var(--color-primary-600)] hover:underline">hello@calciodev.com</a>
        <p class="text-sm text-[var(--text-secondary)] mt-2">We usually reply within a business day.</p>
      </div>
      <div class="p-6 border border-[var(--border)] rounded-lg">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-[var(--text-tertiary)] mb-2">LinkedIn</h3>
        <a href="https://www.linkedin.com/company/calcio-dev-llc" target="_blank" rel="noopener noreferrer" class="text-lg font-semibold text-[var(--color-primary-600)] hover:underline">CALCIO DEV LLC →</a>
        <p class="text-sm text-[var(--text-secondary)] mt-2">Follow along or send a message.</p>
      </div>
    </div>

    <!-- Working hours note -->
    <p class="text-center text-sm text-[var(--text-tertiary)] mt-10">
      We work in UTC-5, overlapping US business hours, in English and Spanish.
    </p>
  </main>

  <Footer slot="footer" />
</BaseLayout>
