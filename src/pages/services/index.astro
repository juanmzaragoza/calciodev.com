---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import Icon from '../../components/ui/Icon.astro';

const title = 'Services';
const description = 'Software development, QA automation, architecture audits, project rescue, embedded analytics and applied AI for growing B2B teams.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://calciodev.com';

const services = [
  { name: 'Architecture & Technical Debt Audit', serviceType: 'Software audit', description: 'A two-week, fixed-scope review of architecture, security, testing, CI/CD, dependencies and scalability, with a prioritized roadmap. USD 1,000–2,000.' },
  { name: 'Project Rescue', serviceType: 'Software development', description: 'Take over half-built or abandoned software, recover code and account ownership, and ship to production.' },
  { name: 'Custom Software & Integrations', serviceType: 'Software development', description: 'Bespoke systems, APIs, integrations (ERP, CRM, legacy) and payments with Stripe.' },
  { name: 'Embedded Analytics & BI', serviceType: 'Business intelligence', description: 'Dashboards inside your product with per-customer isolation (Apache Superset, BigQuery) and automated reports.' },
  { name: 'QA Automation & Release Confidence', serviceType: 'Quality assurance', description: 'Testing from zero, E2E with Playwright and post-deploy quality gates.' },
  { name: 'QA & Release Risk Audit', serviceType: 'Quality assurance', description: '5–7 business days. Review of test suite, pipeline and uncovered critical flows. Risk map + prioritized test plan. USD 1,200, credited toward Critical Flows Suite.' },
  { name: 'Critical Flows Suite', serviceType: 'Quality assurance', description: '3–4 weeks. Playwright E2E for 3–5 critical flows, wired into CI as a quality gate. USD 2,000.' },
  { name: 'QA Retainer', serviceType: 'Quality assurance', description: 'Suite maintenance, flakiness control and new-feature tests. Up to 40 hours/month. USD 1,200/mo.' },
  { name: 'Contractor', serviceType: 'Software development', description: 'Development and/or QA, part-time or full-time. USD 25/h.' },
  { name: 'Custom Software Development', serviceType: 'Software development', description: 'Full-stack web applications built to spec. React, Next.js, Node, Laravel. Price upon scoping.' },
  { name: 'Applied AI', serviceType: 'Artificial intelligence', description: 'Data agents, assistants and document parsing, only when they add real value.' },
];
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    {services.map((s) => (
      <JsonLd
        type="Service"
        data={{
          name: s.name,
          description: s.description,
          serviceType: s.serviceType,
          url: `${siteUrl}/services/`,
          providerName: 'CALCIO',
          providerUrl: `${siteUrl}/`,
          areaServed: ['United States', 'Latin America'],
        }}
      />
    ))}
  </Fragment>
  <Header slot="header" />

  <!-- Hero -->
  <section class="bg-[var(--bg)] pt-20 pb-12 md:pt-28 md:pb-16">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-[var(--text-primary)] mb-6">
        What we do
      </h1>
      <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
        Software development and QA automation for growing teams. We rescue half-built projects, audit technical debt, and make sure releases stop being a gamble.
      </p>
    </div>
  </section>

  <!-- Anchor: Audit -->
  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-6">
      <div class="border-2 border-[var(--color-primary-600)] rounded-lg p-8 md:p-10">
        <span class="text-xs font-semibold uppercase tracking-wide text-[var(--color-primary-600)]">Start here</span>
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--text-primary)] mt-2 mb-4">
          Architecture & Technical Debt Audit
        </h2>
        <p class="text-[var(--text-secondary)] mb-6 max-w-2xl">
          Two weeks, fixed scope. We review architecture, security, tests, CI/CD, dependencies, scalability and multi-tenancy, and hand you a prioritized roadmap. USD 1,000–2,000.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/audit/" class="inline-flex items-center justify-center px-5 py-2.5 bg-[var(--color-primary-600)] text-white font-semibold rounded-lg hover:bg-[var(--color-primary-700)] transition-colors">
            See the Audit
          </a>
          <a href="/case-studies/data-platform/" class="inline-flex items-center justify-center px-5 py-2.5 border border-[var(--border)] text-[var(--text-primary)] font-semibold rounded-lg hover:bg-[var(--bg-secondary)] transition-colors">
            Related case →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Build -->
  <section class="py-12 md:py-16 bg-[var(--bg-secondary)]">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--color-primary-600)] mb-8">Build</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="p-6 border border-[var(--border)] rounded-lg bg-[var(--bg)]">
          <Icon name="life-buoy" class="mb-4" />
          <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">Project Rescue</h3>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            We take over software that's half-built or abandoned, recover ownership of the code and accounts, and get it to production. You end up owning what runs your business.
          </p>
          <a href="/case-studies/listing-los-cabos/" class="text-sm font-semibold text-[var(--color-primary-600)] hover:underline">See Listing Los Cabos →</a>
        </div>
        <div class="p-6 border border-[var(--border)] rounded-lg bg-[var(--bg)]">
          <Icon name="code" class="mb-4" />
          <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">Custom Software & Integrations</h3>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            Systems built to measure, APIs, and integrations with the tools you already use (ERP, CRM, legacy). Payments and subscriptions with Stripe.
          </p>
          <a href="/case-studies/listing-los-cabos/" class="text-sm font-semibold text-[var(--color-primary-600)] hover:underline">See a rescue + build →</a>
        </div>
        <div class="p-6 border border-[var(--border)] rounded-lg bg-[var(--bg)]">
          <Icon name="code" class="mb-4" />
          <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">Custom Software Development</h3>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            Full-stack web applications built to your spec. React, Next.js, Node.js, Laravel. We scope the project first — price defined after a discovery call.
          </p>
          <a href="https://calendly.com/juanmanuelzaragoza/30min" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[var(--color-primary-600)] hover:underline">Book a scoping call →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Connect -->
  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--color-primary-600)] mb-8">Connect</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="p-6 border border-[var(--border)] rounded-lg">
          <Icon name="workflow" class="mb-4" />
          <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">Automation & Integrations</h3>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            Processes that run on their own: custom connectors, Apps Script, WhatsApp and Manychat bots, and data flows that replace the report someone builds by hand every month.
          </p>
          <a href="/case-studies/new-condal/" class="text-sm font-semibold text-[var(--color-primary-600)] hover:underline">See New Condal →</a>
        </div>
        <div class="p-6 border border-[var(--border)] rounded-lg">
          <Icon name="sparkles" class="mb-4" />
          <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">Applied AI</h3>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            Only when it adds real value: data agents, assistants, and document parsing that turns PDFs nobody could analyze into structured, queryable data.
          </p>
          <a href="/case-studies/ivee/" class="text-sm font-semibold text-[var(--color-primary-600)] hover:underline">See IVEE →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Clarify -->
  <section class="py-12 md:py-16 bg-[var(--bg-secondary)]">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--color-primary-600)] mb-8">Clarify</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="p-6 border border-[var(--border)] rounded-lg bg-[var(--bg)]">
          <Icon name="bar-chart-3" class="mb-4" />
          <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">Embedded Analytics & BI</h3>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            Dashboards inside your product, with per-customer isolation so every client sees only their data. Apache Superset, BigQuery, and automated reports.
          </p>
          <a href="/case-studies/data-platform/" class="text-sm font-semibold text-[var(--color-primary-600)] hover:underline">See the data platform →</a>
        </div>
        <div class="p-6 border border-[var(--border)] rounded-lg bg-[var(--bg)]">
          <Icon name="shield-check" class="mb-4" />
          <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">QA Automation & Release Confidence</h3>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            A testing strategy from zero: E2E with Playwright, backend integration tests, and post-deploy quality gates — so releases go from days to minutes.
          </p>
          <a href="/case-studies/ticketing-platform/" class="text-sm font-semibold text-[var(--color-primary-600)] hover:underline">See the ticketing platform →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Test -->
  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--color-primary-600)] mb-8">Test</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="p-6 border border-[var(--border)] rounded-lg">
          <Icon name="shield-check" class="mb-4" />
          <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">QA & Release Risk Audit</h3>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            5–7 business days. Review of your test suite, pipeline and uncovered critical flows. Risk map and prioritized test plan — credited toward the Critical Flows Suite.
          </p>
          <p class="text-sm font-semibold text-[var(--color-primary-600)]">USD 1,200</p>
        </div>
        <div class="p-6 border border-[var(--border)] rounded-lg">
          <Icon name="shield-check" class="mb-4" />
          <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">Critical Flows Suite</h3>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            3–4 weeks. Playwright E2E for 3–5 revenue-critical flows, wired into your CI as a quality gate so every deploy is verified.
          </p>
          <p class="text-sm font-semibold text-[var(--color-primary-600)]">USD 2,000</p>
        </div>
        <div class="p-6 border border-[var(--border)] rounded-lg">
          <Icon name="shield-check" class="mb-4" />
          <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">QA Retainer</h3>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            Suite maintenance, flakiness control and tests for every new feature. Up to 40 hours per month.
          </p>
          <p class="text-sm font-semibold text-[var(--color-primary-600)]">USD 1,200/mo</p>
        </div>
        <div class="p-6 border border-[var(--border)] rounded-lg">
          <Icon name="shield-check" class="mb-4" />
          <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">Contractor</h3>
          <p class="text-sm text-[var(--text-secondary)] mb-4">
            Development and/or QA, part-time or full-time — scale up or down as needed.
          </p>
          <p class="text-sm font-semibold text-[var(--color-primary-600)]">USD 25/h</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-[var(--color-primary-600)] text-white">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Not sure where to start?</h2>
      <p class="mb-8 opacity-95">Book a 30-minute call. We'll figure out whether you need an audit, a build, or QA coverage.</p>
      <a href="/contact/" class="inline-flex items-center justify-center px-6 py-3 bg-white text-[var(--color-primary-600)] font-semibold rounded-lg hover:bg-[var(--bg)] transition-colors">
        Get in touch
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
