---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

// You can use translations here if you want to localize the signup page
---

<BaseLayout
  title="Get Started | Astro SEO Theme"
  description="Start your free trial today. No credit card required."
>
  <Header slot="header" />

  <main class="mx-auto flex w-full max-w-7xl flex-col justify-center px-6 py-20 lg:px-8 xl:py-32">
    <div class="mx-auto w-full max-w-md">
      <div class="text-center">
        <h1 class="font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)]">
          Create your account
        </h1>
        <p class="mt-4 text-lg text-[var(--text-secondary)]">
          Start your 14-day free trial. No credit card required.
        </p>
      </div>

      <div class="mt-10 rounded-3xl border border-[var(--border)] bg-[var(--bg)] p-8 shadow-sm sm:p-10">
        <form action="#" method="POST" class="space-y-6">
          <div>
            <label for="email" class="block text-sm font-medium leading-6 text-[var(--text-primary)]">
              Email address
            </label>
            <div class="mt-2">
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="block w-full rounded-xl border border-[var(--border)] bg-[var(--bg-secondary)] px-4 py-3 text-[var(--text-primary)] shadow-sm focus:border-[var(--color-primary-500)] focus:ring-[var(--color-primary-500)] sm:text-sm"
                placeholder="you@company.com"
              />
            </div>
          </div>

          <div>
            <label for="password" class="block text-sm font-medium leading-6 text-[var(--text-primary)]">
              Password
            </label>
            <div class="mt-2">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                required
                class="block w-full rounded-xl border border-[var(--border)] bg-[var(--bg-secondary)] px-4 py-3 text-[var(--text-primary)] shadow-sm focus:border-[var(--color-primary-500)] focus:ring-[var(--color-primary-500)] sm:text-sm"
                placeholder="••••••••"
              />
            </div>
          </div>

          <div>
            <button
              type="submit"
              class="flex w-full justify-center rounded-xl bg-[var(--color-primary-600)] px-4 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-[var(--color-primary-700)] hover:shadow-md active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary-600)]"
            >
              Start free trial
            </button>
          </div>
        </form>

        <p class="mt-10 text-center text-sm text-[var(--text-secondary)]">
          Already have an account?{' '}
          <a href="/login" aria-label="Sign in to your account" class="font-semibold text-[var(--color-primary-600)] hover:text-[var(--color-primary-700)] dark:text-[var(--color-primary-400)] dark:hover:text-[var(--color-primary-300)]">
            Sign in here
          </a>
        </p>
      </div>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
