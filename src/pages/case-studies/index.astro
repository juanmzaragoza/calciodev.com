---
import { getCollection } from 'astro:content';
import CaseStudyList from '../../layouts/CaseStudyList.astro';

// Get all non-draft case studies, sorted by date descending
const caseStudies = (await getCollection('case-studies'))
  .filter((study) => !study.data.draft && study.id.startsWith('en/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<CaseStudyList
  title="Customer Success Stories"
  description="See how leading B2B SaaS companies use our solutions to scale their growth and dominate organic search."
  caseStudies={caseStudies}
/>
