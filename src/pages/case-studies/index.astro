---
import { getCollection } from 'astro:content';
import CaseStudyList from '../../layouts/CaseStudyList.astro';

// Get all non-draft case studies, sorted by date descending
const caseStudies = (await getCollection('case-studies'))
  .filter((study) => !study.data.draft && study.id.startsWith('en/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<CaseStudyList
  title="Case Studies"
  description="Real projects: rescued platforms, testing built from zero, multi-tenant data systems, and years of critical public-sector software. Here's what we did and what changed."
  caseStudies={caseStudies}
/>
