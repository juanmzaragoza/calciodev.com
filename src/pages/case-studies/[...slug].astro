---
import { getCollection, render } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  const enStudies = caseStudies.filter((study) => study.id.startsWith('en/'));
  return enStudies.map((caseStudy) => ({
    params: { slug: caseStudy.id.replace('en/', '') },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
const { Content } = await render(caseStudy);
---

<CaseStudy caseStudy={caseStudy}>
  <Content />
</CaseStudy>
