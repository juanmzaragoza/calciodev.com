---
import { getCollection } from 'astro:content';
import BlogList from '../../layouts/BlogList.astro';

// Get all non-draft posts, sorted by date descending
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.id.startsWith('en/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BlogList
  title="Our Blog"
  description="Thoughts, insights, and strategies on B2B SaaS, technical SEO, and building high-performance marketing websites."
  posts={posts}
/>
